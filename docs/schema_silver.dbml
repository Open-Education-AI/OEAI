//  ************************************************************************************
//  Tables required for the OEAI Silver Layer
//  
//  ************************************************************************************


// **********************************************************
//  DIMENSION TABLES
// **********************************************************

Table dim_Organisation [headercolor: #011B4E] {
  organisationkey integer [Primary Key, note: 'generated uuid in silver'] 
  external_id varchar [note: 'id for each school used in source system eg from Wonde API']
  unique_key varchar [note: 'external_id + URN or other composite key']
  addresskey integer [note: 'blank']
  Organisation_Type varchar [note: 'phase of education eg Primary']
  LA_Code integer [note: 'format 123']
  Establishment_Number integer [note: 'format 5678']
  URN integer [note: 'format 123456']
  UKPRN integer [note: 'blank']
  Organisation_Status varchar [note: 'Active by default']
  Organisation_Name varchar
  last_updated datetime [note: 'blank']
}


Table dim_Student [headercolor: #011B4E] {
  studentkey integer [primary key, note: 'generated uuid in silver']
  school_id varchar [note: 'id used in source system eg from Wonde API']
  student_id varchar
  unique_key varchar [note: 'school_id + student_id']
  external_id varchar [note: 'optional external identifier if distinct from student_id']
  organisationkey integer [note: 'from dim_Organisation']
  addresskey integer [note: 'not present but links to dim_Address']
  Forename varchar
  Surname varchar
  Middle_Names varchar
  Legal_Forename varchar
  Legal_Surname varchar
  Gender varchar [note: 'format MALE, FEMALE or as specified in MIS']
  Sex varchar [note: 'may overlap with Gender; retain if both are used']
  Date_Of_Birth varchar [note: 'formats are inconsistent']
  UPN varchar
  Current_Year varchar [note: 'NC Year']
  Year_Group varchar [note: 'Calculated from Group Membership']
  updated_at datetime
  Is_Deleted varchar [note: 'Used for soft delete tracking']
}


Ref: dim_Student.organisationkey > dim_Organisation.organisationkey

Table dim_StudentExtended [note: 'No note', headercolor: #011B4E] {
  studentextendedkey integer [primary key]  
  school_id varchar [note: 'id used in source system eg from Wonde API']
  student_id varchar
  unique_key varchar [note: 'school_id + student_id']
  studentkey integer [note: 'from dim_Student']
  organisationkey varchar [note: 'from dim_Organisation']

  Current_Year varchar [note: 'derived from GroupMembership']
  NC_Year varchar [note: 'National Curriculum Year']
  Year_Group varchar [note: 'present in PySpark as Year_Group']
  Current_NC_Year varchar [note: 'present in PySpark as Current_NC_Year']

  Religion varchar
  Ethnicity varchar
  Ethnicity_Code varchar
  Nationality varchar [note: 'currently None']
  Sen_Status varchar
  First_Language varchar [note: 'short code eg ENG']
  
  In_LEA_Care bit [note: 'TRUE/FALSE']
  Ever_In_Care bit [note: 'True, False or None (sometimes only True/None)']
  Free_School_Meals bit [note: 'currently True, False or None']
  Free_School_Meals_6 bit [note: 'TRUE/FALSE']
  English_As_Additional_Language bit [note: 'currently True, False or None']
  English_As_Additional_Language_Status bit [note: 'currently None']
  Pupil_Premium_Indicator bit
  Pupil_Premium_Eligible bit
  Service_Child_Indicator bit [note: 'currently True, False or None']
  Gifted_And_Talented_Status bit [note: 'TRUE/FALSE']
  Child_Protection_Plan bit [note: 'currently True, False or None']
  Child_In_Need bit [note: 'currently True, False or None']
  
  Enrolment_Status varchar [note: 'inconsistent']
  Admission_Date date [note: 'formats are inconsistent']
  Admission_Number integer
  Leaving_Date varchar [note: '?????']

  Is_Current bit [note: 'present in PySpark, boolean flag']
  Postcode varchar [note: 'postcode from student record']

  // last_updated datetime [note: 'currently commented out']
}


Ref: dim_StudentExtended.studentkey > dim_Student.studentkey

Table dim_StudentCalculated [note: 'Gold only, not Silver',headercolor: #E4A62E] {
  studentkey integer [note: 'from dim_Student']
  is_current bit [note: '0/1']
  Is_Current_String varchar [note: 'Current, Not Current']
  is_sen bit [note: '0/1']
  Is_SEN_String varchar [note: 'SEN, Not SEN']
  is_summer_born bit [note: '0/1']
  Is_Summer_Born_String varchar [note: 'Summer Born, Not Summer Born']
  }

Ref: dim_StudentCalculated.studentkey > dim_Student.studentkey




Table dim_Address [headercolor: #011B4E] {
  addresskey integer [primary key]
  external_id varchar [note: 'id used in source system']
  Composite_Address varchar 
  Address_Line_1 varchar
  Address_Line_2 varchar
  Address_Line_3 varchar
  City varchar
  State_or_Province  varchar
  Postcode varchar
  Type varchar
  Status varchar
  Longitude float
  Latitude float
  Easting float
  Northing float
  last_updated datetime
}
Ref: dim_Address.addresskey > dim_Organisation.addresskey
Ref: dim_Address.addresskey > dim_Student.addresskey

Table dim_Group [headercolor: #011B4E] {
  groupkey integer [primary key, note: 'uuid generated in silver']
  school_id varchar [note: 'id used in source system eg from Wonde API']
  unique_key varchar [note: 'school_id + student_id']
  organisationkey integer [note: 'from dim_Organisation']
  Group_Name varchar
  Group_Code varchar 
  Group_Type varchar [note: 'House, Registration etc']
  Group_Description varchar
  //Subject varchar // possibly only populated for Classes
  //Status varchar
  //last_updated datetime
}

Ref: dim_Group.groupkey < dim_GroupMembership.groupkey

Table dim_GroupMembership [headercolor: #011B4E] {
  groupmembershipkey integer [primary key, note: 'uuid generated in silver']
  groupkey integer [note: 'from dim_Group']
  organisationkey integer [note: 'from dim_Organisation']
  studentkey integer [note: 'from dim_Student'] 
  school_id varchar [note: 'id used in source system eg from Wonde API']
  student_id varchar
  Group_Name varchar
  Group_Type varchar
  unique_key varchar [note: 'school_id + student_id + external_id']
  Start_Date date 
  End_Date date 
}

Ref: dim_GroupMembership.studentkey > dim_Student.studentkey

// Table dim_Period
Table dim_Period [headercolor: #011B4E] {
  periodkey integer [primary key]
  external_id varchar [note: 'id used in source system']
  organisationkey integer
  Start_Time varchar
  End_Time varchar
  Period_Name varchar
  Period_Day varchar
  Period_Day_Number integer
  Period_Description varchar
  last_updated datetime
}

Ref: dim_Period.organisationkey > dim_Organisation.organisationkey

// Table dim_Assessment
Table dim_Assessment [headercolor: #011B4E] {
  assessmentkey varchar [primary key]
  aspect_id varchar
  created_at_date datetime
  description text
  max_value varchar
  min_value varchar
  mis_id integer
  name text
  school_id varchar
  type text
  unique_key varchar
  updated_at_date datetime
  organisationkey varchar
}

Ref: dim_Assessment.organisationkey > dim_Organisation.organisationkey
Ref: dim_Assessment.aspect_id > fact_Result.aspect_id

// Table dim_ResultSet
Table dim_ResultSet [headercolor: #011B4E] {
  resultsetkey varchar [primary key]
  create_at_date datetime
  end_date datetime
  end_date_date datetime //to be cleaned up
  resultset_id varchar
  locked bool
  mis_id integer
  module varchar
  name varchar
  school_id varchar
  source varchar
  start_date datetime
  start_date_date datetime //to be cleaned up
  supplier varchar
  unique_key varchar
  updated_at_time datetime
  organisationkey varchar

}

Ref: dim_ResultSet.organisationkey > dim_Organisation.organisationkey
Ref: dim_ResultSet.resultset_id > fact_Result.resultset_id

// Table dim_Employee
Table dim_Employee [headercolor: #011B4E] {
  employeekey integer [primary key]
  external_id varchar [note: 'id used in source system']
  organisationkey integer
  Title varchar
  Initials varchar
  Surname varchar
  Forename varchar
  Legal_Surname varchar
  Legal_Forename varchar
  Gender varchar
  Date_Of_Birth date
  teachingstaff bit
  staffcode varchar
  Role_Text varchar
  Qualified_Teacher_Status varchar
  Higher_Level_Teaching_Assistant_Status bit
  Employment_Start_Date date
  Employment_End_Date date
  last_updated datetime
}



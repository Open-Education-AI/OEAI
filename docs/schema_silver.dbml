  Day_Number_Of_Month integer
  Day_Number_Of_Week_Sun_Start integer
  Month_Name varchar
  Month_Name_Abbreviation varchar
  Day_Name varchar
  Day_Name_Abbreviation varchar
  Day_Number_Of_Week integer
  Academic_Year varchar
  Academic_Month_Number integer
  Academic_Week_Number_Of_Year integer
  Academic_Year_Period varchar

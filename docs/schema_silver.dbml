// Table dim_User_Filter to be completed
Table dim_UserFilter [headercolor: #2D6512] {
  userfilterkey varchar
}



// **********************************************************
//  FACT TABLES
// **********************************************************

// Table fact_AttendanceSummary
Table fact_AttendanceSummary {
  attendancesummarykey varchar [primary key, note: 'uuid generated in silver'] 
  
  studentkey varchar [note: 'from dim_Student']
  organisationkey varchar [note: 'from dim_Organisation']
  
  external_id varchar [note: 'id for each school used in source system eg from Wonde API']
  student_id integer
  school_id varchar [note: 'id used in source system eg from Wonde API']

  unique_student_id varchar [note: 'school_id + student_id']
  unique_key varchar [note: 'school_id + student_id + external_id']

  Authorised_Absences integer
  Unauthorised_Absences integer
  Unexplained_Absences integer
  Late_Before_Registration integer
  Late_After_Registration integer
  Possible_Marks integer
  Missing_Marks integer
  Attendance_Not_Required integer
  Present integer
  Approved_Education_Activity integer

  Attendance_Mark_String varchar [note: 'field often empty']

  Percentage_Attendance decimal(10,0)
  Percentage_Authorised_Absence decimal(10,0)
  Percentage_Unauthorised_Absence decimal(10,0)
  Percentage_Unexplained_Absence decimal(10,0)
  Percentage_Missing decimal [note: 'not defined in schema, may be calculated']

  Is_Persistently_Absent boolean
  Is_Severely_Absent boolean

  last_updated datetime

  // Can we get Minutes late? a common request currently
}


Ref: fact_AttendanceSummary.organisationkey > dim_Organisation.organisationkey
Ref: fact_AttendanceSummary.studentkey > dim_Student.studentkey


// Table fact_AttendanceSession
Table fact_AttendanceSession {
  attendancesessionkey integer [primary key]
  external_id varchar [note: 'id used in source system']
  organisationkey integer
  school_id varchar [note: 'from source system if relevant']
  studentkey integer
  student_id varchar
  unique_key varchar [note: 'composite id if used']
  
  date date
  Session varchar
  Mark varchar
  is_present bit
  is_auth_abs bit
  is_unauth_abs bit
  is_possible bit

  is_attend bit [note: 'attendance flag']
  is_aea bit [note: 'authorized educational activity']
  is_late_L bit [note: 'late before register closes']
  is_late_U bit [note: 'late after register closes']
  is_missing bit [note: 'missing code']
  is_nr bit [note: 'not required to attend']

  Comment varchar
  Employee varchar
  last_updated datetime
}

Ref: fact_AttendanceSession.organisationkey > dim_Organisation.organisationkey
Ref: fact_AttendanceSession.studentkey > dim_Student.studentkey


// Table fact_AttendanceLesson
Table fact_AttendanceLesson {
  attendancelessonkey integer [primary key]
  external_id varchar [note: 'id used in source system']
  unique_key varchar [note: 'composite key if used']
  school_id varchar [note: 'from source system']
  student_id varchar
  studentkey integer [note: 'foreign key to dim_Student']
  organisationkey integer [note: 'foreign key to dim_Organisation']
  
  period_instance_id varchar [note: 'identifier for a specific period session']
  periodkey varchar [note: 'foreign key to dim_Period']
  lesson_id varchar [note: 'individual lesson ID']
  Full_Date date
  Date date [note: 'alternative date field if Full_Date is deprecated']
  start_at varchar [note: 'start time of lesson']
  end_at varchar [note: 'end time of lesson']
  Subject varchar

  Attendance_String varchar [note: 'Wonde attendance_code - links to Attendance Codes']
  attendancecode varchar
  Period_Name varchar [note: 'lookup from dim_Period']
  Period_Description varchar [note: 'lookup from dim_Period']
  
  is_present bit
  is_auth_abs bit
  is_unauth_abs bit
  is_possible bit
  is_attend bit
  is_aea bit
  is_late_L bit
  is_late_U bit
  is_missing bit
  is_nr bit

  Comment varchar
  last_updated datetime
}


Ref: fact_AttendanceLesson.organisationkey > dim_Organisation.organisationkey
Ref: fact_AttendanceLesson.studentkey > dim_Student.studentkey
Ref: fact_AttendanceLesson.periodkey > dim_Period.periodkey


// Table fact_Achievement 
Table fact_Achievement {
  achievementkey varchar [primary key, note: 'uuid generated in silver']
  external_id varchar [note: 'id used in source system']
  organisationkey varchar [note: 'from dim_Organisation']

  unique_key varchar [note: 'school_id + student_id + external_id']

  student_id varchar
  school_id varchar [note: 'id used in source system eg from Wonde API']
  studentkey varchar [note: 'from dim_Student']

  Type varchar
  Subject varchar
  Class varchar [note: 'inconsistent? Some empty']

  Points integer
  Total_Points integer
  Comment varchar [note: 'inconsistent? Some empty']

  Achievement_Date varchar [note: 'stored as string in PySpark']
  last_updated varchar [note: 'stored as string in PySpark']
}

Ref: fact_Achievement.organisationkey > dim_Organisation.organisationkey
Ref: fact_Achievement.studentkey > dim_Student.studentkey



// Table fact_Behaviour 
Table fact_Behaviour {
  behaviourkey varchar [primary key, note: 'uuid generated in silver']
  external_id varchar [note: 'id used in source system']
  
  // unique_student_id varchar [note: 'school_id + student_id']
  unique_key varchar [note: 'school_id + student_id + external_id']

  student_id varchar
  school_id varchar
  studentkey varchar [note: 'foreign key to dim_Student']
  organisationkey integer [note: 'foreign key to dim_Organisation']
  datekey integer [note: 'e.g., YYYYMMDD format or foreign key to dim_Date']

  Type varchar
  Location varchar
  Status varchar
  Action varchar
  Subject varchar
  Class varchar

  Points integer
  Total_Points integer
  Comment varchar

  Incident_Date date [note: 'format from source system']
  last_updated datetime

  // Missing: comments & outcome/outcome_code
}


Ref: fact_Behaviour.organisationkey > dim_Organisation.organisationkey
Ref: fact_Behaviour.studentkey > dim_Student.studentkey

// Table fact_Exclusion 
Table fact_Exclusion {
  exclusionkey integer [primary key]
  external_id varchar [note: 'id used in source system']
  school_id varchar
  student_id varchar
  organisationkey integer
  studentkey integer
  Type varchar //  [Fixed Term, Permanent, Reinstated from Permanent, Suspension]
  Type_Code varchar //  [FIXD,PERM,RPER,SUSP]
  Reason varchar // Explode comma separated in Bronze to Silver to multiple records
  Reason_Code varchar // Explode comma separated in Bronze to Silver to multiple records
  Start_Date varchar
  End_Date varchar
  Start_Session varchar
  End_Session varchar
  Sessions float
  Days float
  Academic_Year varchar
  Term varchar
  Comments varchar
  Agencies_Involved varchar
  Discipline_Committee_Date date
  Discipline_Committee_Result varchar
  Appeal_Received bit
  Appeal_Result varchar
  Appeal_Result_Date date
  unique_student_id varchar [note: 'school_id + student_id']
  unique_key varchar [note: 'school_id + student_id + external_id']
  last_updated datetime
}

Ref: fact_Exclusion.organisationkey > dim_Organisation.organisationkey
Ref: fact_Exclusion.studentkey > dim_Student.studentkey

// Table fact_Detention 
Table fact_Detention {
  detentionkey integer [primary key]
  external_id varchar [note: 'id used in source system']
  organisationkey integer
  studentkey integer
  datekey integer // lookup based on start_time date datepart
  Detention_Type varchar
  Comment varchar
  Room varchar
  Start_Time datetime
  End_Time datetime
  Attended_By_Employee varchar
  last_updated datetime
}

Ref: fact_Detention.organisationkey > dim_Organisation.organisationkey
Ref: fact_Detention.studentkey > dim_Student.studentkey

// Table fact_Result
Table fact_Result {
  resultkey integer [primary key]
  aspect_id varchar
  collection_date_date datetime
  created_at_date datetime
  grade_value integer
  result_id varchar
  mis_id integer
  result varchar
  result_date datetime
  resultset_id varchar
  school_id varchar
  student_id varchar
  unique_key varchar
  updated_at_date datetime
  organisationkey varchar
  studentkey varchar

}

Ref: fact_Result.studentkey > dim_Student.studentkey

// Table dim_Staff
Table dim_Staff {
  school_id string
  staff_id integer
  Legal_Forename string
  Legal_Surname string
  Forename string
  Surname string
  Date_Of_Birth date
  Title string
  Legacy_System_ID string
  Sex string
  Gender string //Not available in Wonde
  Continuous_Service_Start_Date timestamp
  QTS boolean
  EYTS boolean //Not available in Wonde
  QTLS boolean //Not available in Wonde
  HLTA boolean
  Is_Teacher boolean // Inconsistently completed
  staffkey string [primary key]
  organisationkey string
  Is_Current integer //Is available in Wonde, is derived from most recent contract in Arbor
}

// Table fact_StaffAbsence
Table fact_StaffAbsence {
  external_id string
  staff_id integer
  Days float
  Hours float
  Start_Date timestamp
  End_Date timestamp
  Type string
  Is_Paid_Leave boolean
  Is_Paid_Holiday boolean //Not available in Wonde
  Is_Paid_Maternity boolean //Not available in Wonde
  Is_Paid_Paternity boolean //Not available in Wonde
  Is_Authorised_Absence boolean //Not available in Wonde
  Sickness_Category string
  school_id string
  staffabsencekey string [primary key]
  organisationkey string
  staffkey string
  Authorised_Pay_Rate string // Not in Arbor
}

Ref: fact_StaffAbsence.staffkey > dim_Staff.staffkey


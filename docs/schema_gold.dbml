// **********************************************************
//  FACT TABLES
// **********************************************************

Table fact_Achievement {
  studentkey                  varchar
  Academic_Year               varchar
  Type                        varchar
  Points                      integer
  Achievement_Date            date
  studentacademicyeargroupkey integer
}

Table fact_Attainment {
  attainmentkey               varchar      [primary key]
  studentkey                  varchar
  Academic_Year               varchar
  QAN                         varchar
  Assessment_Name             varchar
  Assessment_Code             varchar
  Assessment_Date             date
  Result                      varchar
  Result_Value                varchar
  Comment                     varchar
  Period_Name                 varchar
  unique_key                  varchar
  studentacademicyeargroupkey integer
}

Table fact_AttendanceSession {
  studentacademicyeargroupkey integer
  Academic_Year               varchar
  studentkey                  varchar
  Mark                        varchar
  Session                     varchar
  Date                        date
  is_auth_abs                 integer
  is_unauth_abs               integer
  is_possible                 integer
  is_present                  integer
  is_aea                      integer
  is_late_L                   integer
  is_late_U                   integer
  is_missing                  integer
  is_nr                       integer
  is_attend                   integer
  Is_10_in_10                 integer
  3_days_abs                  integer
  abs_after_exclusion         integer
  cumulative_present          bigint
  cumulative_possible         bigint
  attendance_ratio            double
  is_PA                       integer
  is_SA                       integer
}

Table fact_AttendanceSummary {
  attendancesummarykey        varchar      [primary key]
  studentkey                  varchar
  Academic_Year               varchar
  unique_student_id           varchar
  Present                     bigint
  Authorised_Absences         bigint
  Unauthorised_Absences       bigint
  Possible_Marks              bigint
  Approved_Educational_Activity bigint
  Late_Before_Registration     bigint
  Late_After_Registration      bigint
  unique_key                  varchar
  student_id                  integer
  school_id                   varchar
  Attendance_Mark_String      varchar
  Percentage_Attendance       decimal(10,4)
  Percentage_Authorised_Absence decimal(10,4)
  Percentage_Unauthorised_Absence decimal(10,4)
  external_id                 varchar
  last_updated                varchar
  Unexplained_Absences        integer
  Missing_Marks               integer
  Percentage_Missing          decimal(10,4)
  Attendance_Not_Required     integer
  Percentage_Unexplained_Absence decimal(10,0)
  Is_Persistently_Absent      integer
  Is_Severely_Absent          integer
  under_50                    integer
  50_to_70                    integer
  70_to_80                    integer
  80_to_90                    integer
  90_to_92                    integer
  92_to_95                    integer
  95_to_98                    integer
  above_98                    integer
  Attendance_Bin              varchar
  organisationkey             varchar
  studentacademicyeargroupkey integer
}

Table fact_Behaviour {
  studentkey                  varchar
  Academic_Year               varchar
  datekey                     varchar
  Type                        varchar
  Action                      varchar
  Points                      integer
  Incident_Date               date
  studentacademicyeargroupkey integer
}

Table fact_Exclusion {
  exclusionkey                varchar       [primary key]
  studentkey                  varchar
  Academic_Year               varchar
  student_id                  varchar
  Start_Date                  date
  End_Date                    varchar
  Discipline_Commitee_Date    varchar
  external_id                 varchar
  school_id                   varchar
  Reason                      varchar
  Reason_Code                 varchar
  Days                        varchar
  Start_Session               varchar
  End_Session                 varchar
  Comments                    varchar
  Type                        varchar
  Type_Code                   varchar
  Sessions                    varchar
  Term                        varchar
  Agencies_Involved           varchar
  Appeal_Received             varchar
  Appeal_Result               varchar
  Appeal_Result_Date          varchar
  last_updated                varchar
  unique_key                  varchar
  organisationkey             varchar
  studentacademicyeargroupkey integer
}

Table fact_StaffAbsence {
  staffabsencekey             varchar      [primary key]
  external_id                 varchar
  staff_id                    integer
  Days                        float
  Hours                       float
  Start_Date                  datetime
  End_Date                    datetime
  Type                        varchar
  Is_Paid_Leave               boolean
  Is_Paid_Holiday             boolean
  Is_Paid_Maternity           boolean
  Is_Paid_Paternity           boolean
  Is_Authorised_Absence       boolean
  Sickness_Category           varchar
  school_id                   varchar
  Note                        varchar
  Authorised_Pay_Rate         varchar
  unique_key                  varchar
  organisationkey             varchar
  staffkey                    varchar
}



// **********************************************************
//  RELATIONSHIPS
// **********************************************************

Ref: dim_GroupMembership.groupkey              > dim_Group.groupkey
Ref: dim_GroupMembership.studentkey            > dim_Student.studentkey
Ref: dim_SENDNeed.studentkey                   > dim_Student.studentkey
Ref: dim_Staff.organisationkey                 > dim_Organisation.organisationkey
Ref: dim_Student.organisationkey               > dim_Organisation.organisationkey
Ref: dim_StudentAcademicYearGroup.studentkey                    > dim_Student.studentkey
Ref: dim_StudentExtended.studentkey            > dim_Student.studentkey
Ref: dim_StudentExtendedAcademicYear.studentkey                > dim_Student.studentkey
Ref: dim_StudentCalculated.studentkey          > dim_Student.studentkey
Ref: fact_Achievement.studentacademicyeargroupkey > dim_StudentAcademicYearGroup.studentacademicyeargroupkey
Ref: fact_Attainment.studentacademicyeargroupkey     > dim_StudentAcademicYearGroup.studentacademicyeargroupkey
Ref: fact_AttendanceSession.studentacademicyeargroupkey > dim_StudentAcademicYearGroup.studentacademicyeargroupkey
Ref: fact_AttendanceSummary.studentacademicyeargroupkey > dim_StudentAcademicYearGroup.studentacademicyeargroupkey
Ref: fact_Behaviour.studentacademicyeargroupkey > dim_StudentAcademicYearGroup.studentacademicyeargroupkey
Ref: fact_Exclusion.studentacademicyeargroupkey > dim_StudentAcademicYearGroup.studentacademicyeargroupkey
Ref: fact_Exclusion.external_id < dim_ExclusionReason.external_id
Ref: fact_StaffAbsence.staffkey               > dim_Staff.staffkey
Ref: dim_StudentAcademicYearGroup.Academic_Year <> dim_Date.AcademicYear
Ref: fact_Achievement.Achievement_Date > dim_Date.FullDate
Ref: fact_Attainment.Assessment_Date > dim_Date.FullDate
Ref: fact_AttendanceSession.Date > dim_Date.FullDate
Ref: fact_Behaviour.Incident_Date > dim_Date.FullDate
Ref: fact_Exclusion.Start_Date > dim_Date.FullDate
Ref: fact_StaffAbsence.Start_Date > dim_Date.FullDate


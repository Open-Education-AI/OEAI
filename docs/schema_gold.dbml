// ************************************************************************************
//  Tables required for the OEAI Gold Layer
// ************************************************************************************

// **********************************************************
//  DIMENSION TABLES
// **********************************************************

Table dim_Date [headercolor: #011B4E] {
  DateKey                              integer       [primary key]
  FullDate                             varchar
  MonthNumberOfYear                    integer
  MonthNumberOfQuarter                 integer
  ISOYearAndWeekNumber                 varchar
  ISOWeekNumberOfYear                  integer
  SSWeekNumberOfYear                   integer
  ISOWeekNumberOfQuarter_454_Pattern   integer
  SSWeekNumberOfQuarter_454_Pattern    integer
  SSWeekNumberOfMonth                  integer
  DayNumberOfYear                      integer
  DaysSince1900                        integer
  DayNumberOfFiscalYear                integer
  DayNumberOfQuarter                   integer
  DayNumberOfMonth                     integer
  DayNumberOfWeek_Sun_Start            integer
  MonthName                            varchar
  MonthNameAbbreviation                varchar
  DayName                              varchar
  DayNameAbbreviation                  varchar
  DayNumberOfWeek                      integer
  AcademicYear                         varchar
  AcademicMonthNumber                  integer
  AcademicWeekNumberOfYear             integer
  TermSession                          varchar
  CalendarYear                         integer
  CalendarYearMonth                    varchar
  CalendarYearQtr                      varchar
  CalendarSemester                     integer
  CalendarQuarter                      integer
  CalendarWeekNumber                   integer
  FiscalYear                           integer
  FiscalMonth                          integer
  FiscalQuarter                        integer
  FiscalYearMonth                      varchar
  FiscalYearQtr                        varchar
  QuarterNumber                        integer
  YYYYMMDD                             integer
  MMDDYYYY                             varchar
  MonDDYYYY                            varchar
  IsCurrentYear                        integer
  IsLastDayOfMonth                     varchar
  IsWeekday                            varchar
  IsWeekend                            varchar
  IsWorkday                            varchar
  IsFederalHoliday                     varchar
  IsBankHoliday                        varchar
  IsCompanyHoliday                     varchar
  AcademicYearPeriod                   varchar
  WeekStartDate                        varchar
  WeekCommencing_DDMMYYYY              varchar
  WeekCommencingName                   varchar
  Year_Month_Number                    integer
  DayNumberofAcademicYear              integer
}

Table dim_ExclusionReason [headercolor: #011B4E] {
  exclusionreasonkey   varchar       [primary key]
  external_id          varchar
  school_id            varchar
  Reason_Code          varchar
  Is_Main              integer
  unique_key           varchar
  organisationkey      varchar
}

Table dim_Group [headercolor: #011B4E] {
  groupkey         varchar       [primary key]
  external_id      varchar
  Group_Code       integer
  Group_Name       varchar
  Group_Description varchar
  school_id        varchar
  organisationkey  varchar
  Group_Type       varchar
  Group_ID         varchar
  unique_key       varchar
}

Table dim_GroupMembership [headercolor: #011B4E] {
  groupmembershipkey varchar     [primary key]
  external_id        varchar
  unique_student_id  varchar
  student_id         integer
  group_unique_id    varchar
  Start_Date         date
  End_Date           date
  school_id          varchar
  student_mis_id     varchar
  Student_Date       varchar
  groupkey           varchar
  organisationkey    varchar
  studentkey         varchar
  Group_Name         varchar
  Group_Type         varchar
  unique_key         varchar
  last_updated       varchar
}

Table dim_Organisation [headercolor: #011B4E] {
  organisationkey    varchar       [primary key]
  external_id        varchar
  Organisation_Name  varchar
  Establishment_Number varchar
  URN                varchar
  LA_Code            varchar
  Organisation_Type  varchar
  unique_key         varchar
  addresskey         varchar
  UKPRN              varchar
  Organisation_Status varchar
  last_updated       varchar
}

Table dim_SENDNeed [headercolor: #011B4E] {
  sendneedkey        varchar       [primary key]
  external_id        varchar
  student_id         integer
  SENDNeed_Type      varchar
  SENDNeed_Description varchar
  SENDNeed_Ranking   integer
  Start_Date         date
  End_Date           date
  school_id          varchar
  unique_key         varchar
  organisationkey    varchar
  studentkey         varchar
}

Table dim_Staff [headercolor: #011B4E] {
  staffkey                  varchar   [primary key]
  staff_id                  integer
  Legal_Forename            varchar
  Legal_Surname             varchar
  Forename                  varchar
  Surname                   varchar
  Date_Of_Birth             date
  Title                     varchar
  Legacy_System_ID          varchar
  Sex                       varchar
  Gender                    varchar
  Continuous_Service_Start_Date datetime
  QTS                       boolean
  EYTS                      boolean
  QTLS                      boolean
  HLTA                      boolean
  school_id                 varchar
  organisationkey           varchar
  unique_key                varchar
  Is_Teacher                boolean
}

Table dim_Student [headercolor: #011B4E] {
  studentkey      varchar       [primary key]
  student_id      varchar
  school_id       varchar
  unique_key      varchar
  external_id     varchar
  Forename        varchar
  Legal_Forename varchar
  Legal_Surname   varchar
  Surname         varchar
  Middle_Names    varchar
  Sex             varchar
  Gender          varchar
  Date_Of_Birth   varchar
  UPN             varchar
  updated_at      varchar
  organisationkey varchar
}


Table dim_StudentAcademicYearGroup [headercolor: #011B4E] {
  studentacademicyeargroupkey integer [primary key]
  studentkey        varchar
  Academic_Year     varchar
  Year_Group        varchar
  std_year_group    varchar
  CompulsorySchoolAge integer
  Phase             varchar
  OnRollOnCensus    varchar
}

Table dim_StudentCalculated [headercolor: #011B4E] {
  studentkey          varchar       [primary key]
  is_sen              integer
  Is_SEN_String       varchar
  Is_PP_String        varchar
  Is_EAL_String       varchar
  is_summer_born      integer
  Is_Summer_Born_String varchar
  Is_Current_String   varchar
  Full_Name           varchar
}



Table dim_StudentExtended [headercolor: #011B4E] {
  studentextendedkey    varchar       [primary key]
